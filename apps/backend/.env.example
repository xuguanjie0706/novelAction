DATABASE_URL=postgresql://novel:novel@localhost:5432/novel_db
REDIS_URL=redis://localhost:6379/0

# ── 远程大模型（推荐：管理后台「大模型」或下方 OpenAI 兼容变量） ──
# GEMINI_BASE_URL=https://api.example.com/v1
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ── 可选：仅当前端仍选「本地」线路时（OpenAI 兼容，如 Ollama）；默认创作流走远程时可不配置 ──
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# AI_MODEL=你的本地模型 id
# LLM_HTTP_CONNECT_TIMEOUT=30
# LLM_HTTP_READ_TIMEOUT=900

# 可选：覆盖各场景 max_tokens（勿超过模型/网关单次输出上限）
# Bootstrap 串行各步大块 JSON 的 chat.completions max_tokens 统一上限（默认 65536）
# BOOTSTRAP_COMPLETION_MAX_TOKENS=131072
# 首卷章纲 Step 12.5：默认 40960，60 章可整卷一次生成；实测 30 章输出约 16k token
# VOL1_CHAPTERS_MAX_TOKENS=40960
# GEMINI_SINGLE_SHOT_MAX_TOKENS=32768
# GEMINI_EXPAND_OUTLINE_MAX_TOKENS=20000
# GEMINI_DRAFT_STREAM_MAX_TOKENS=8192

# ── pgvector 语义记忆检索（embedding）────────────────────────────────────────
# OpenAI 兼容 /v1/embeddings；留空则跟随 LLM_BASE_URL / LLM_API_KEY。
# 方案 A（远程，如 SiliconFlow）：
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=你的_key
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_DIM=1024
# 方案 B（本地 Ollama）：EMBEDDING_BASE_URL=http://localhost:11434/v1，nomic-embed-text，768 维
# 换模型/维度后重启后端，再：cd apps/backend && python verify_pgvector.py --reembed

# ── 书籍封面存储（磁盘 ↔ 对象桶，仅改配置切换；默认本地磁盘）──────────────
# COVER_STORAGE_BACKEND=local      # 默认。别名：disk / filesystem
# COVER_STORAGE_BACKEND=cos        # 腾讯云桶。别名：bucket / tencent_cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-guangzhou
# COS_BUCKET=your-bucket-1250000000
# COS_PREFIX=novel-covers/
# COS_PUBLIC_BASE_URL=https://your-cdn.example.com   # 可选：自定义 CDN 域名

SECRET_KEY=change-me-in-production
DEBUG=true

# 若本地前端端口不是 3173/3174（见项目根目录 env.local.ports.example），需允许跨域，例如：
# CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]

# 管理后台账号（apps/frontend，端口 3174；与创作端用户体系隔离）
# 留空 = 关闭管理后台登录入口；启用时建议改为强口令并仅在受信网络部署。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
