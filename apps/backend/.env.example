DATABASE_URL=postgresql://novel:novel@localhost:5432/novel_db
REDIS_URL=redis://localhost:6379/0

# ── 推荐：远程大模型（管理后台「大模型」或下方环境变量） ──
# 前端生成向导里选「远程」时使用；与串行/单次方案无关。
# GEMINI_BASE_URL=http://www.example.com:3333
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-free

# ── 可选：仅当在前端选择「本地」线路时才会走这里（OpenAI 兼容，含 Ollama 等） ──
# 远程线路的模型名在管理后台「大模型」里配置，不由本项决定。
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# AI_MODEL=你的本地模型 id（与 Ollama / 网关里名称一致；不选本地线路时可不写）
# 连接/读超时（秒）
# LLM_HTTP_CONNECT_TIMEOUT=30
# LLM_HTTP_READ_TIMEOUT=900

# 若本地端点不是 Ollama，改为你的 base_url / key / model 即可，例如：
# LLM_BASE_URL=https://your-api-proxy.com/v1
# LLM_API_KEY=sk-your-real-key
# AI_MODEL=your-model-id

# 可选：覆盖各场景 max_tokens（勿超过模型上限）
# GEMINI_SINGLE_SHOT_MAX_TOKENS=32768
# GEMINI_EXPAND_OUTLINE_MAX_TOKENS=20000
# GEMINI_DRAFT_STREAM_MAX_TOKENS=8192

SECRET_KEY=change-me-in-production
DEBUG=true

# 若本地前端端口不是 3173/3174（见项目根目录 env.local.ports.example），需允许跨域，例如：
# CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]

# 管理后台账号（apps/frontend，端口 3174；与创作端用户体系隔离）
# 留空 = 关闭管理后台登录入口；启用时建议改为强口令并仅在受信网络部署。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
