DATABASE_URL=postgresql://novel:novel@localhost:5432/novel_db
REDIS_URL=redis://localhost:6379/0

# ── 本地模型（Ollama 默认） ──────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
AI_MODEL=qwen3:8b

# ── 切换到远程自定义端点时，替换上面三行 ─────────────
# LLM_BASE_URL=https://your-api-proxy.com/v1
# LLM_API_KEY=sk-your-real-key
# AI_MODEL=qwen3:8b   # 或其他模型名

# ── 可选：单独配置 Gemini（用于 single_shot） ─────────
# GEMINI_BASE_URL=https://your-api-proxy.com/v1
# GEMINI_API_KEY=sk-your-real-key
# GEMINI_MODEL=gemini-3-flash

SECRET_KEY=change-me-in-production
DEBUG=true

# 若本地前端端口不是 5173（见项目根目录 env.local.ports.example），需允许跨域，例如：
# CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
